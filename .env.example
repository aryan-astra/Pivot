# PIVOT environment variables
#
# Every value here is OPTIONAL. With no .env file at all and no keys set, PIVOT
# starts, runs its whole test suite, and executes tasks using its built-in
# deterministic providers.
#
# Copy to `.env` at the repo root to use it:
#     Copy-Item .env.example .env
# The backend loads it at startup; Vite loads it for the frontend.

# === Runtime configuration (the only section PIVOT currently reads) ===
# Relative paths resolve against backend/ regardless of your working directory.
DB_PATH=data/runtime.db
PORT=8000
LOG_LEVEL=INFO

# CORS: comma-separated origins, or * for local development.
CORS_ORIGINS=*

# === Frontend ===
# Absolute backend URL, baked in at build time. Leave empty for same-origin
# (the production single-process setup). The vite dev server uses BACKEND_URL.
VITE_API_URL=
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=5173

# === Browser executor ===
# Headless Chromium is the default. Set false if you want to watch the real
# browser drive a page (needs a display).
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENT=3


# === Reserved for external model providers — NOT READ BY THIS BUILD ===
#
# `backend/providers/` defines the interfaces PIVOT would use for pluggable
# language-model, decision, speech-to-text and search backends, and ships
# deterministic implementations of all four. The shipped runtime executes every
# interruption, invalidation, fencing and recovery step locally, so it never
# needs a remote model. These names are recorded here for the provider adapters
# that are not part of this submission; setting them today changes nothing.
#
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# JEV_API_KEY=
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_BASE_URL=
# FALLBACK_LLM_MODEL=
