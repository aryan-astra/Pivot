# === API keys (all optional — PIVOT runs deterministically without them) ===

# Main LLM provider (reasoning only; never used for state diff / fencing)
# Recommended: Google Gemini (free tier) — Alternative: Groq
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Structured decision provider (JEV or alternative; optional)
JEV_API_KEY=

# Speech-to-text provider (optional; browser Web Speech API is the default)
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=

# === Runtime configuration ===
# Relative paths resolve against backend/
DB_PATH=data/runtime.db
PORT=8000
LOG_LEVEL=INFO

# CORS: comma-separated origins, or * for local dev
CORS_ORIGINS=*

# === Frontend ===
# Absolute backend URL baked at build time (docker) — empty = same origin
VITE_API_URL=
# Backend URL used by vite dev proxy
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=5173

# === Browser configuration ===
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENT=3

# === Provider fallback ===
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=
