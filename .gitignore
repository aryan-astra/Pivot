# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.egg-info/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Secrets — .env.example is the only env file that belongs in the repo
.env
.env.local
.env.production
!.env.example

# Runtime state (SQLite databases, WAL sidecars)
backend/data/
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs, OS cruft
*.log
logs/
.DS_Store
Thumbs.db

# Local-only agent notes and scratch documents — never committed
AGENTS.md
docs/ORIGINAL_README.md
docs/LIVE_BROWSER_BUILD_PLAN.md
skills-lock.json
.agents/
.playwright-mcp/

# Superseded prototype workspaces, kept on disk only as a local reference.
# The application in this repository is backend/ + frontend/ at the root.
Frontend-option1/
Frontend-option2/
workspace-*/

# Captures: screenshots, video frames and traces written out while debugging or
# building presentation material. The repository is source only — none of this
# belongs in a submission, and the underscore variants are deliberately matched
# too so `git add -A` cannot pick them up.
screenshots/
frames/
traces/
PIVOT_PRESENTATION_ASSETS/
pivot-*.png
pivot_*.png

# Video workspace.
#
# The Remotion project under video/ is a local production workspace, not part of
# the submitted application: it depends on capture artefacts that are not
# committed, and the film it builds is not referenced by the README. Keeping the
# whole directory out avoids shipping a half-configured second npm project and a
# Remotion render cache to anyone cloning the repo. If it is ever finished and
# referenced, replace this block with targeted ignores for its build output
# (node_modules/, out/, .remotion/, capture/frames/) rather than a blanket one.
video/
